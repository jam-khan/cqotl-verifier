Prove Bernoulli : forall (x : CVar[bit]), 
    forall (q1' : QReg[bit]), forall (b1' : CVar[bit]),
    forall (q2' : QReg[bit]), forall (b2' : CVar[bit]),
    forall (x' : CVar[bit]),
        { false -> 0O[bit]_(q1', q1') | 0O[bit]_(q1', q1') }
            x <-$ Bern1'4;
                ~
            init q1';
            unitary H q1';
            b1' := meas (P0, P1) q1';
            init q2';
            unitary H q2';
            b2' := meas (P0, P1) q2';
            x' := and @ b1' @ b2';
        { ~(x == x') -> 0O[bit]_(q1', q1') | 0O[bit]_(q1', q1') }.

    intro x. intro q1'. intro b1'. intro q2'. intro b2'. intro x'.

    r_seq 1 -1 ~(x == and @ b1' @ b2') -> 0O[bit]_(q1', q1') | 0O[bit]_(q1', q1').
    choose 2.
    r_assign. simpl_entail. refl.
    

    (* Pause. *)
    r_duality.

    intro n.
    intro gamma.
    intro omega.
    intro H.

    
    
    (* start backward transformation *)
    r_seq 1 -1 ((((~ (x == false)) -> P1_(q2', q2')) /\ ((~ (x == b1')) -> P0_(q2', q2'))) | 
        ((P0_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ b1') @ false)) @ P0_(q2', q2'))) + 
        (P1_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ b1') @ true)) @ P1_(q2', q2'))))).
    choose 2.

    r_meas. 
    rewrite (LemmaAndFalse1 @ b1').
    rewrite (LemmaAndTrue1 @ b1').
    simpl. simpl_entail. simpl. cq_entail. split.
        intro Hx. simpl. sorry.
        intro Hx. simpl. sorry.

    r_seq 1 -1 ((((~ (x == false)) -> P1_(q2', q2')) /\ ((~ (x == b1')) -> P0_(q2', q2'))) | 
        (((H^D @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ b1') @ false)) @ (P0 @ H)_(q2', q2'))) + 
        ((H^D @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ b1') @ true)) @ (P1 @ H)_(q2', q2'))))).
    choose 2.
        r_unitary. dirac. simpl_entail. split.
            cq_entail. simpl. split.
            intro Hx. rewrite Hx. simpl. sorry.
            intro Hx. rewrite Hx. simpl. sorry.
            sorry.

    r_seq 1 -1 ((((~ (x == false)) -> P1_(q2', q2')) /\ ((~ (x == b1')) -> P0_(q2', q2'))) | SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q2', q2') @ ((((H^D) @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ b1') @ false)) @ (P0 @ H)_(q2', q2'))) + (((H^D) @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ b1') @ true)) @ (P1 @ H)_(q2', q2'))))) @ (|false> @ <i|)_(q2', q2')))]).
    choose 2.
        r_initq. simpl_entail. simpl. cq_entail. split. 
            intro Hx. rewrite Hx. simpl. sorry.
            intro Hx. rewrite Hx. simpl. sorry.


    r_seq 1 -1 (((false -> 0O[bit]_(q1', q1'))) | ((P0_(q1', q1') @ (SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q2', q2') @ ((((H^D) @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ false) @ false)) @ (P0 @ H)_(q2', q2'))) + (((H^D) @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ false) @ true)) @ (P1 @ H)_(q2', q2'))))) @ (|false> @ <i|)_(q2', q2')))] @ P0_(q1', q1'))) + (P1_(q1', q1') @ (SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q2', q2') @ ((((H^D) @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ true) @ false)) @ (P0 @ H)_(q2', q2'))) + (((H^D) @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ true) @ true)) @ (P1 @ H)_(q2', q2'))))) @ (|false> @ <i|)_(q2', q2')))] @ P1_(q1', q1'))))).
    choose 2.
    r_meas. simpl. simpl_entail. simpl. cq_entail. split.
        intro Hx. rewrite Hx. simpl. sorry.
        intro Hx. rewrite Hx. simpl. sorry.
    

    r_seq 1 -1 ((false -> 0O[bit]_(q1', q1')) | (((H^D)_(q1', q1') @ ((P0_(q1', q1') @ (SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q2', q2') @ ((((H^D) @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ false) @ false)) @ (P0 @ H)_(q2', q2'))) + (((H^D) @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ false) @ true)) @ (P1 @ H)_(q2', q2'))))) @ (|false> @ <i|)_(q2', q2')))] @ P0_(q1', q1'))) + (P1_(q1', q1') @ (SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q2', q2') @ ((((H^D) @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ true) @ false)) @ (P0 @ H)_(q2', q2'))) + (((H^D) @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ true) @ true)) @ (P1 @ H)_(q2', q2'))))) @ (|false> @ <i|)_(q2', q2')))] @ P1_(q1', q1'))))) @ H_(q1', q1'))).
    choose 2.
        r_unitary. dirac. simpl_entail. refl.

    r_seq 1 -1 ((false -> 0O[bit]_(q1', q1')) | SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q1', q1') @ (((H^D)_(q1', q1') @ ((P0_(q1', q1') @ (SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q2', q2') @ ((((H^D) @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ false) @ false)) @ (P0 @ H)_(q2', q2'))) + (((H^D) @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ false) @ true)) @ (P1 @ H)_(q2', q2'))))) @ (|false> @ <i|)_(q2', q2')))] @ P0_(q1', q1'))) + (P1_(q1', q1') @ (SUM[USET[bit], (fun (i : CTerm[bit]) => (((|i> @ <false|)_(q2', q2') @ ((((H^D) @ P0)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ true) @ false)) @ (P0 @ H)_(q2', q2'))) + (((H^D) @ P1)_(q2', q2') @ ((((gamma @ x) * 1O[(bit * bit)]_((q1', q2'), (q1', q2'))) + ((omega @ true) @ true)) @ (P1 @ H)_(q2', q2'))))) @ (|false> @ <i|)_(q2', q2')))] @ P1_(q1', q1'))))) @ H_(q1', q1'))) @ (|false> @ <i|)_(q1', q1')))]).
    choose 2.
        r_initq. simpl_entail. simpl. cq_entail. intro Hx. simpl. dirac. simpl_entail. refl.

    r_sample.

    Pause.

    (* lean obligation *)
    sorry.

QED.
    

    


