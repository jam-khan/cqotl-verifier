Def P0 : OType[bit, bit] := |false> @ < false|.
Def P1 : OType[bit, bit] := |true> @ <true|.

Var Psym2 : OType[bit * bit, bit * bit].

Prove Lemma1 : forall (x : CTerm[bit]), ~ ~ x = x.

    intro x. simpl. refl.

QED.

Prove Lemma2 : forall (x : CTerm[bit]), 
    forall (H : ~ x = true), x = false.
    intro x. intro H.
    rewrite <- Lemma1 @ x.
    rewrite H. simpl. refl.
QED.

Prove Lemma3 : forall (x : CTerm[bit]), forall (y : CTerm[bit]),
    forall (H : ((x == y) = true)), x = y.

    intro x. intro y.
    case x. 
        rewrite CASE0.
        case y. 
            rewrite CASE00. intro H. refl.
            rewrite CASE1. simpl. intro H. destruct H.

        rewrite CASE1.
        case y. 
            rewrite CASE0. simpl. intro H. destruct H.
            rewrite CASE10. intro H. refl.

QED.

